{
    "getAll": {
        "description": "Gets all entries from 'departments'",
        "route": "/departments",
        "method": "GET",
        "sql": "SELECT * FROM departments",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    },
    "getById": {
        "description": "Gets an entry from 'departments' by its primary key",
        "route": "/departments/$department_id",
        "method": "GET",
        "sql": "SELECT * FROM departments WHERE department_id = $department_id",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    },
    "create": {
        "description": "Creates a new entry in 'departments'",
        "route": "/departments",
        "method": "POST",
        "sql": "INSERT INTO departments(name_dep, city) VALUES ($name_dep, $city)",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ],
        "request_body_params": [
            "name_dep",
            "city"
        ]
    },
    "update": {
        "description": "Updates an existing entry in 'departments' by its primary key",
        "route": "/departments/$department_id",
        "method": "PUT",
        "sql": "UPDATE departments SET name_dep = $name_dep, city = $city WHERE department_id = $department_id",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ],
        "request_body_params": [
            "name_dep",
            "city"
        ]
    },
    "delete": {
        "description": "Deletes an existing entry in 'departments' by its primary key",
        "route": "/departments/$department_id",
        "method": "DELETE",
        "sql": "DELETE FROM departments WHERE department_id = $department_id",
        "auth_required": false,
        "allowed_roles": [
            "*"
        ]
    }
}
